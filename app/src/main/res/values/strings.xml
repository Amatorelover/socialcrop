    <string name="about_section_intro">About this app</string>
    <string name="about_intro_p1">SocialCrop adapts any photo to the sizes each platform needs: crop to a ratio, slice a tall image into a seamless grid, or use a designed frame to keep the whole picture and avoid the black and white bars that show up when cropping or expanding.</string>
    <string name="about_intro_p2">All image processing happens on your device. No login, no upload. Export and share straight to Xiaohongshu, Douyin, WeChat, Instagram, X and more via the system share sheet.</string>

    <string name="about_section_privacy">Privacy</string>
    <string name="about_privacy_1">No network permission — check AndroidManifest.xml yourself, there is no INTERNET</string>
    <string name="about_privacy_2">No data collection: no analytics, no tracking, no ads, no accounts</string>
    <string name="about_privacy_3">Photos are picked with the system Photo Picker and saved through MediaStore; images and frame settings stay on your device</string>

    <string name="about_section_opensource">Open source</string>
    <string name="about_opensource_p1">This project is licensed under the MIT License: use, modify and redistribute freely. The full text is in LICENSE at the repository root.</string>
    <string name="about_opensource_p2">Built on Kotlin, Jetpack Compose, AndroidX, Material Design components and ExifInterface. Image processing uses no third-party image library.\nThanks to everyone who sent suggestions and bug reports.</string>
    <string name="about_opensource_repo_hint">Source repository (MIT licensed; issues and PRs welcome):</string>
    <string name="about_view_source">Open repository</string>
    <string name="about_copy_version">Copy version info</string>
    <string name="about_version_line">SocialCrop v%1$s (%2$d) · Android %3$s (API %4$d)</string>

    <string name="about_section_disclaimer">Disclaimer</string>
    <string name="about_disclaimer_p1">This is an independently developed personal project, for learning and personal use. The original photos remain the property of their owners; you are responsible for following each platform rules and local laws when using exported images.</string>
    <string name="about_disclaimer_p2">The software is provided as is, without warranty of any kind. You bear the consequences of using it.</string>

    <string name="about_section_sponsor">Support the project</string>
    <string name="about_sponsor_body">SocialCrop is completely free, with no ads and no tracking. If it helped you, consider buying me a coffee ☕ — your support keeps it maintained. Sponsorship is entirely voluntary and comes with no feature promise or service obligation.</string>
